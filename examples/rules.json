{
  "max_total_bytes": 120000,
  "max_estimated_tokens": 30000,
  "max_file_bytes": 50000,
  "required_paths": [
    "README.md",
    "src/**",
    "tests/**"
  ],
  "forbidden_paths": [
    ".env",
    ".env.*",
    "**/*.pem",
    "**/*.key",
    "**/.git/**",
    "**/node_modules/**"
  ],
  "sensitive_patterns": [
    "(?i)api[_-]?key\\s*[:=]\\s*['\\\"]?[A-Za-z0-9_\\-]{16,}",
    "(?i)secret\\s*[:=]\\s*['\\\"]?[A-Za-z0-9_\\-]{12,}",
    "-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----",
    "(?i)ghp_[A-Za-z0-9]{20,}"
  ],
  "todo_patterns": [
    "TODO",
    "FIXME"
  ],
  "allow_todos": false,
  "require_readme": true,
  "require_tests": true,
  "require_ci": true,
  "fail_on": [
    "error"
  ]
}
